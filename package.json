{
  "name": "joplin-plugin-joplinmemo",
  "version": "0.4.2",
  "description": "View ordinary Joplin notes as compact, colorful memo boards.",
  "license": "MIT",
  "keywords": [
    "joplin-plugin",
    "memo",
    "viewer",
    "notes"
  ],
  "files": [
    "CHANGELOG.md",
    "publish"
  ],
  "scripts": {
    "build": "npm run dist",
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "verify:package": "node tests/verify-package.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^18.7.13",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "jsdom": "^29.1.1",
    "tar": "^7.5.13",
    "ts-loader": "^9.3.1",
    "typescript": "^4.8.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "markdown-it": "^15.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
